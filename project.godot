config_version=5

[application]
config/name="Forest Ruins Godot"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=1
window/vsync/vsync_mode=0

[benchmark]
fixed_resolution=false

[rendering]
renderer/rendering_method="forward_plus"
; Forward+ fails to compile internal pipelines on affected Android Adreno drivers.
renderer/rendering_method.mobile="mobile"
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/use_taa=true
anti_aliasing/quality/use_taa.mobile=false
textures/vram_compression/import_etc2_astc=true
; Four cascades share the directional shadow atlas.
; Android's default mobile override halves the atlas and severely undersamples thin foliage.
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/size.mobile=4096
; Keep Android shadow filtering at the same quality as desktop.
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=2

[input_devices]
pointing/emulate_mouse_from_touch=false
